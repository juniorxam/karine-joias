# Configuração usada pelas Supabase Edge Functions da Violetta
INFINITEPAY_HANDLE=violettaprataesemijoias
PUBLIC_SITE_URL=https://violetta.com.br

# SUPABASE_URL e chave de serviço devem ser fornecidas pelo ambiente seguro do Supabase.
# Nunca publique chaves reais neste arquivo.
# Google Cloud: habilite Routes API e configure a chave somente como segredo da Edge Function.
GOOGLE_MAPS_API_KEY=
