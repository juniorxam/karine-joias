{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/loja/:path*", "destination": "/index.html" },
    { "source": "/minha-conta/:path*", "destination": "/index.html" },
    { "source": "/pedido/:path*", "destination": "/index.html" },
    { "source": "/gestao/:path*", "destination": "/index.html" }
  ]
}
